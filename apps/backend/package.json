{
  "name": "@consultorio-gaviotas/backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "prototype": "bun run src/prototype/consulta-flow.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elysia": "^1.1.0",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/static": "^1.1.0",
    "pg": "^8.12.0",
    "zod": "^3.23.0",
    "bcryptjs": "^2.4.3",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}