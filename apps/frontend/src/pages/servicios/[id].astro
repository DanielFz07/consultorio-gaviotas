---
import Layout from "../../layouts/Layout.astro";
import {api, isError, getApiUrl} from "../../lib/api";

const { id } = Astro.params;
const r = await api.get<{ id: number; codigo: string; nombre: string; descripcion: string; precio: string; duracion_minutos: number; activo: boolean }>(
  Astro, `/api/servicios/${id}`
);
const servicio = r.ok && !isError(r.data) ? r.data : null;

const token = Astro.cookies.get("consultorio-gaviotas_token")?.value ?? "";
const API_URL = getApiUrl();

let error: string | null = null;
let mensaje: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const accion = f.get("accion")?.toString();
  if (accion === "toggle") {
    const res = await fetch(`${API_URL}/api/servicios/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
      body: JSON.stringify({ activo: !servicio?.activo }),
    });
    if (res.ok) {
      return Astro.redirect(`/servicios/${id}?msg=toggled`);
    }
    const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
    error = errData.message ?? "Error";
  } else {
    const body = {
      codigo: f.get("codigo")?.toString() || null,
      nombre: f.get("nombre")?.toString() ?? "",
      descripcion: f.get("descripcion")?.toString() || null,
      precio: Number(f.get("precio") ?? 0),
      duracionMinutos: Number(f.get("duracionMinutos") ?? 30),
    };
    const res = await fetch(`${API_URL}/api/servicios/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
      body: JSON.stringify(body),
    });
    if (res.ok) {
      return Astro.redirect(`/servicios/${id}?msg=guardado`);
    }
    const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
    error = errData.message ?? "Error al guardar";
  }
}

const msg = Astro.url.searchParams.get("msg");
if (msg === "guardado") mensaje = "Cambios guardados";
if (msg === "toggled") mensaje = "Estado actualizado";
---
<Layout title={servicio ? servicio.nombre : "Servicio"}>
  <a href="/servicios" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink mb-4 transition-colors">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    Volver a servicios
  </a>

  {!servicio ? (
    <div class="bg-white rounded-2xl border border-line p-12 text-center">
      <p class="text-muted">Servicio no encontrado.</p>
    </div>
  ) : (
    <>
      <div class="mb-6 flex items-end justify-between flex-wrap gap-3">
        <div>
          <div class="text-xs text-muted font-mono">{servicio.codigo || "sin código"}</div>
          <h1 class="font-display text-3xl font-bold text-ink mt-1">{servicio.nombre}</h1>
          <p class="text-muted mt-1 text-sm">{servicio.descripcion || "Sin descripción"}</p>
        </div>
        <div class="text-right">
          <div class="text-xs text-muted">Precio</div>
          <div class="text-3xl font-bold font-mono text-ink">${Number(servicio.precio).toFixed(2)}</div>
          <div class="text-xs text-muted">{servicio.duracion_minutos} min</div>
        </div>
      </div>

      {mensaje && <div class="mb-4 p-3.5 rounded-xl bg-success-soft border border-success/20 text-success text-sm">{mensaje}</div>}
      {error && <div class="mb-4 p-3.5 rounded-xl bg-danger-soft border border-danger/20 text-danger text-sm">{error}</div>}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
          <h2 class="font-semibold text-ink mb-4">Información del servicio</h2>
          <form method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="codigo">Código</label>
                <input id="codigo" name="codigo" value={servicio.codigo ?? ""} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all font-mono" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="duracionMinutos">Duración (minutos) <span class="text-danger">*</span></label>
                <input id="duracionMinutos" name="duracionMinutos" type="number" min="1" required value={servicio.duracion_minutos} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all font-mono" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink mb-1.5" for="nombre">Nombre <span class="text-danger">*</span></label>
              <input id="nombre" name="nombre" required value={servicio.nombre} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink mb-1.5" for="descripcion">Descripción</label>
              <textarea id="descripcion" name="descripcion" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all resize-none">{servicio.descripcion ?? ""}</textarea>
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink mb-1.5" for="precio">Precio <span class="text-danger">*</span></label>
              <input id="precio" name="precio" type="number" step="0.01" min="0" required value={Number(servicio.precio).toFixed(2)} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all font-mono" />
            </div>
            <div class="flex items-center gap-3 pt-2">
              <button type="submit" class="btn btn-primary">Guardar cambios</button>
              <a href="/servicios" class="btn btn-ghost">Cancelar</a>
            </div>
          </form>
        </div>

        <div class="space-y-4">
          <div class="bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
            <h3 class="font-semibold text-ink mb-2">Estado</h3>
            <p class="text-xs text-muted mb-3">
              {servicio.activo ? "Este servicio está activo y aparece disponible para agendar." : "Este servicio está inactivo. Actívalo para que vuelva a aparecer."}
            </p>
            <form method="POST">
              <input type="hidden" name="accion" value="toggle" />
              <button type="submit" class={`w-full ${servicio.activo ? "btn btn-danger" : "btn btn-primary"}`}>
                {servicio.activo ? "Desactivar servicio" : "Activar servicio"}
              </button>
            </form>
          </div>
        </div>
      </div>
    </>
  )}
</Layout>