---
import Layout from "../../layouts/Layout.astro";
import { api, isError } from "../../lib/api";

const user = Astro.locals.user;
if (!user || (user.rol !== "ADMIN" && user.rol !== "MEDICO")) {
  return Astro.redirect("/dashboard");
}

const r = await api.get<Array<{ id: number; paciente_nombre: string; fecha: string; hora_inicio: string; estado: string }>>(Astro, "/api/citas");
const data = r.ok && !isError(r.data) ? r.data : [];
const citas = Array.isArray(data) ? data.filter((c) => c.estado !== "ATENDIDA" && c.estado !== "CANCELADA") : [];
---
<Layout title="Consultas">
  <div class="mb-6">
    <h1 class="font-display text-3xl font-bold text-ink">Consultas pendientes</h1>
    <p class="text-muted mt-1">Citas que aún no se han atendido.</p>
  </div>

  <div class="bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] overflow-hidden">
    {citas.length === 0 ? (
      <div class="px-6 py-20 text-center">
        <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-br from-brand-50 to-accent-50 grid place-items-center mb-4" style="background:linear-gradient(to bottom right,#e8ebf3,var(--color-accent-50))">
          <svg class="w-10 h-10 text-brand-500" style="color:#0f1d3d" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
        </div>
        <p class="font-display text-xl font-semibold text-ink">Cola vacía</p>
        <p class="text-sm text-muted mt-1.5">No hay consultas esperando atención.</p>
      </div>
    ) : (
      <table class="w-full">
        <thead class="bg-line-soft/50 border-b border-line">
          <tr class="text-left text-xs text-muted uppercase tracking-wider">
            <th class="px-6 py-3 font-semibold">Fecha</th>
            <th class="px-6 py-3 font-semibold">Hora</th>
            <th class="px-6 py-3 font-semibold">Paciente</th>
            <th class="px-6 py-3 font-semibold">Estado</th>
            <th class="px-6 py-3 font-semibold text-right">Acción</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {citas.map((c) => (
            <tr class="hover:bg-line-soft/30 transition-colors">
              <td class="px-6 py-4 text-ink tabular-nums">{c.fecha}</td>
              <td class="px-6 py-4 font-semibold text-ink tabular-nums">{String(c.hora_inicio).slice(0, 5)}</td>
              <td class="px-6 py-4 font-medium text-ink">{c.paciente_nombre}</td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-brand-50 text-brand-700" style="background:#e8ebf3;color:var(--color-navy)">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500" style="background:#0f1d3d"></span>
                  {c.estado.replace("_", " ")}
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <a href={`/consultas/${c.id}`} class="btn btn-primary">
                  Atender
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</Layout>