---
import Layout from "../../layouts/Layout.astro";
import {api, isError, getApiUrl} from "../../lib/api";

const { id } = Astro.params;
const r = await api.get<{ id: number; sku: string; nombre: string; descripcion: string; unidad: string; precio_venta: string; stock_actual: number; stock_minimo: number; activo: boolean }>(
  Astro, `/api/productos/${id}`
);
const producto = r.ok && !isError(r.data) ? r.data : null;

const token = Astro.cookies.get("consultorio-gaviotas_token")?.value ?? "";
const API_URL = getApiUrl();

let error: string | null = null;
let mensaje: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const accion = f.get("accion")?.toString();

  if (accion === "eliminar") {
    const res = await fetch(`${API_URL}/api/productos/${id}`, {
      method: "DELETE",
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) return Astro.redirect("/inventario");
    const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
    error = errData.message ?? "Error al eliminar";
  } else if (accion === "reponer") {
    const cant = Number(f.get("cantidad") ?? 0);
    const res = await fetch(`${API_URL}/api/productos/${id}/reponer`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
      body: JSON.stringify({ cantidad: cant }),
    });
    if (res.ok) {
      return Astro.redirect(`/inventario/${id}?msg=reponer`);
    }
    const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
    error = errData.message ?? "Error al reponer";
  } else {
    const body = {
      sku: f.get("sku")?.toString() || null,
      nombre: f.get("nombre")?.toString() ?? "",
      descripcion: f.get("descripcion")?.toString() || null,
      unidad: f.get("unidad")?.toString() || "unidad",
      precioVenta: Number(f.get("precioVenta") ?? 0),
      stockMinimo: Number(f.get("stockMinimo") ?? 0),
    };
    const res = await fetch(`${API_URL}/api/productos/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
      body: JSON.stringify(body),
    });
    if (res.ok) {
      return Astro.redirect(`/inventario/${id}?msg=guardado`);
    }
    const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
    error = errData.message ?? "Error al guardar";
  }
}

const msg = Astro.url.searchParams.get("msg");
if (msg === "guardado") mensaje = "Cambios guardados";
if (msg === "reponer") mensaje = "Stock repuesto";
---
<Layout title={producto ? producto.nombre : "Producto"}>
  <a href="/inventario" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink mb-4 transition-colors">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    Volver a inventario
  </a>

  {!producto ? (
    <div class="bg-white rounded-2xl border border-line p-12 text-center">
      <p class="text-muted">Producto no encontrado.</p>
    </div>
  ) : (
    <>
      <div class="mb-6 flex items-end justify-between flex-wrap gap-3">
        <div>
          <div class="text-xs text-muted font-mono">{producto.sku || "sin SKU"}</div>
          <h1 class="font-display text-3xl font-bold text-ink mt-1">{producto.nombre}</h1>
          <p class="text-muted mt-1 text-sm">{producto.descripcion || "Sin descripción"}</p>
        </div>
        <div class="text-right">
          <div class="text-xs text-muted">Stock actual</div>
          <div class={`text-3xl font-bold font-mono ${producto.stock_actual <= producto.stock_minimo ? "text-warning" : "text-ink"}`}>{producto.stock_actual}</div>
          <div class="text-xs text-muted">mín. {producto.stock_minimo} {producto.unidad}</div>
        </div>
      </div>

      {mensaje && <div class="mb-4 p-3.5 rounded-xl bg-success-soft border border-success/20 text-success text-sm">{mensaje}</div>}
      {error && <div class="mb-4 p-3.5 rounded-xl bg-danger-soft border border-danger/20 text-danger text-sm">{error}</div>}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
          <h2 class="font-semibold text-ink mb-4">Información del producto</h2>
          <form method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="sku">SKU</label>
                <input id="sku" name="sku" value={producto.sku ?? ""} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all font-mono" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="unidad">Unidad</label>
                <input id="unidad" name="unidad" value={producto.unidad} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink mb-1.5" for="nombre">Nombre <span class="text-danger">*</span></label>
              <input id="nombre" name="nombre" required value={producto.nombre} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink mb-1.5" for="descripcion">Descripción</label>
              <textarea id="descripcion" name="descripcion" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all resize-none">{producto.descripcion ?? ""}</textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="precioVenta">Precio venta <span class="text-danger">*</span></label>
                <input id="precioVenta" name="precioVenta" type="number" step="0.01" min="0" required value={Number(producto.precio_venta).toFixed(2)} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all font-mono" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="stockMinimo">Stock mínimo</label>
                <input id="stockMinimo" name="stockMinimo" type="number" min="0" value={producto.stock_minimo} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all font-mono" />
              </div>
            </div>
            <div class="flex items-center gap-3 pt-2">
              <button type="submit" class="btn btn-primary">Guardar cambios</button>
              <a href="/inventario" class="btn btn-ghost">Cancelar</a>
            </div>
          </form>
        </div>

        <div class="space-y-4">
          <div class="bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
            <h3 class="font-semibold text-ink mb-3">Reponer stock</h3>
            <form method="POST" class="flex items-end gap-2">
              <input type="hidden" name="accion" value="reponer" />
              <div class="flex-1">
                <label class="block text-xs font-semibold text-muted mb-1" for="cantidad">Cantidad a agregar</label>
                <input id="cantidad" name="cantidad" type="number" min="1" required class="w-full px-3 py-2 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all font-mono" />
              </div>
              <button type="submit" class="btn btn-primary h-[42px]">+ Reponer</button>
            </form>
          </div>

          <div class="bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
            <h3 class="font-semibold text-ink mb-2">Eliminar</h3>
            <p class="text-xs text-muted mb-3">Marca el producto como inactivo. No se borrará el historial.</p>
            <form method="POST" onsubmit="return confirm('¿Eliminar este producto?')">
              <input type="hidden" name="accion" value="eliminar" />
              <button type="submit" class="w-full px-4 py-2 rounded-xl bg-white border border-danger/30 text-danger text-sm font-semibold hover:bg-danger-soft transition-colors">Eliminar producto</button>
            </form>
          </div>
        </div>
      </div>
    </>
  )}
</Layout>