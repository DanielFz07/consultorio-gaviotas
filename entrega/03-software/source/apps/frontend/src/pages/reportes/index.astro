---
import Layout from "../../layouts/Layout.astro";
import { api, isError } from "../../lib/api";

const user = Astro.locals.user;
if (!user || user.rol !== "ADMIN") {
  return Astro.redirect("/dashboard");
}

const medicosRes = await api.get<any[]>(Astro, "/api/usuarios");
const medicos = medicosRes.ok && !isError(medicosRes.data)
  ? medicosRes.data.filter((u) => u.rol === "MEDICO" || u.rol === "ADMIN")
  : [];

const hoy = new Date().toISOString().slice(0, 10);
const hace30 = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

const desde = Astro.url.searchParams.get("desde") ?? hace30;
const hasta = Astro.url.searchParams.get("hasta") ?? hoy;
const medicoId = Astro.url.searchParams.get("medicoId") ?? "";

const buildPdfUrl = (path: string) => {
  const qs = new URLSearchParams();
  if (desde) qs.set("desde", desde);
  if (hasta) qs.set("hasta", hasta);
  if (medicoId) qs.set("medicoId", medicoId);
  const s = qs.toString();
  return `${path}${s ? "?" + s : ""}`;
};
---
<Layout title="Reportes">
  <div class="mb-6">
    <h1 class="font-display text-3xl font-bold text-ink">Reportes</h1>
    <p class="text-muted mt-1">Genera reportes en PDF con filtros aplicables.</p>
  </div>

  <div class="bg-white rounded-2xl border border-line shadow-sm p-6 mb-6">
    <h2 class="font-display text-lg font-bold text-ink mb-4">Filtros</h2>
    <form method="GET" id="filterForm" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5" for="desde">Desde</label>
        <input id="desde" name="desde" type="date" value={desde} class="w-full px-4 py-2.5 rounded-xl border border-line" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5" for="hasta">Hasta</label>
        <input id="hasta" name="hasta" type="date" value={hasta} class="w-full px-4 py-2.5 rounded-xl border border-line" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5" for="medicoId">Médico</label>
        <select id="medicoId" name="medicoId" class="w-full px-4 py-2.5 rounded-xl border border-line bg-white">
          <option value="">Todos</option>
          {medicos.map((m: any) => (
            <option value={m.id} selected={medicoId === String(m.id)}>{m.nombre}</option>
          ))}
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="btn btn-primary w-full">Aplicar filtros</button>
      </div>
    </form>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <a href={buildPdfUrl("/api/reportes/consultas/pdf")} target="_blank"
       class="block card hover:-translate-y-0.5 transition-all group">
      <div class="w-12 h-12 rounded-xl grid place-items-center text-cream mb-4" style="background:var(--color-navy);color:var(--color-cream)">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
      <h3 class="font-display text-lg font-bold text-ink group-hover:text-navy">Reporte de Consultas</h3>
      <p class="text-sm text-muted mt-1">Listado de consultas con paciente, médico, síntomas y diagnóstico.</p>
      <p class="text-xs text-gold mt-3 font-semibold" style="color:var(--color-gold-600)">Ver PDF →</p>
    </a>

    <a href={buildPdfUrl("/api/reportes/citas/pdf")} target="_blank"
       class="block card hover:-translate-y-0.5 transition-all group">
      <div class="w-12 h-12 rounded-xl grid place-items-center text-cream mb-4" style="background:var(--color-navy);color:var(--color-cream)">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <h3 class="font-display text-lg font-bold text-ink group-hover:text-navy">Reporte de Citas</h3>
      <p class="text-sm text-muted mt-1">Agenda de citas por rango de fecha y médico.</p>
      <p class="text-xs text-gold mt-3 font-semibold" style="color:var(--color-gold-600)">Ver PDF →</p>
    </a>

    <a href={buildPdfUrl("/api/reportes/pacientes/pdf")} target="_blank"
       class="block card hover:-translate-y-0.5 transition-all group">
      <div class="w-12 h-12 rounded-xl grid place-items-center text-cream mb-4" style="background:var(--color-navy);color:var(--color-cream)">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <h3 class="font-display text-lg font-bold text-ink group-hover:text-navy">Listado de Pacientes</h3>
      <p class="text-sm text-muted mt-1">Catálogo de pacientes con cédula, contacto y total de consultas.</p>
      <p class="text-xs text-gold mt-3 font-semibold" style="color:var(--color-gold-600)">Ver PDF →</p>
    </a>
  </div>
</Layout>