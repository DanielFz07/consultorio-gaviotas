---
import Layout from "../../layouts/Layout.astro";
import {api, isError, getApiUrl} from "../../lib/api";

interface Usuario {
  id: number;
  username: string;
  nombre: string;
  email: string | null;
  rol: "ADMIN" | "MEDICO" | "RECEPCION";
  activo: boolean;
  created_at: string;
}

const user = Astro.locals.user;
if (!user || user.rol !== "ADMIN") {
  return Astro.redirect("/dashboard");
}

const { id } = Astro.params;
const r = await api.get<Usuario>(Astro, `/api/usuarios/${id}`);
const usuario = r.ok && !isError(r.data) ? r.data : null;

const token = Astro.cookies.get("consultorio-gaviotas_token")?.value ?? "";
const API_URL = getApiUrl();

let error: string | null = null;
let mensaje: string | null = null;

if (Astro.request.method === "POST" && usuario) {
  const f = await Astro.request.formData();
  const accion = f.get("accion")?.toString();

  if (accion === "eliminar" && usuario.username !== "admin") {
    const res = await fetch(`${API_URL}/api/usuarios/${id}`, {
      method: "DELETE",
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) return Astro.redirect("/usuarios?msg=eliminado");
    const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
    error = errData.message ?? "Error al eliminar";
  } else if (accion === "toggle" && usuario.username !== "admin") {
    const res = await fetch(`${API_URL}/api/usuarios/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
      body: JSON.stringify({ activo: !usuario.activo }),
    });
    if (res.ok) return Astro.redirect(`/usuarios/${id}?msg=toggled`);
    const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
    error = errData.message ?? "Error al cambiar estado";
  } else if (accion === "eliminar") {
    error = "No se puede eliminar el usuario admin principal";
  } else {
    const body: Record<string, unknown> = {
      nombre: f.get("nombre")?.toString() ?? usuario.nombre,
      email: f.get("email")?.toString() || null,
      rol: f.get("rol")?.toString() ?? usuario.rol,
    };
    const password = f.get("password")?.toString();
    if (password && password.length > 0) {
      if (password.length < 6) {
        error = "La contraseña debe tener al menos 6 caracteres";
      } else {
        body.password = password;
      }
    }
    if (!error) {
      const res = await fetch(`${API_URL}/api/usuarios/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify(body),
      });
      if (res.ok) return Astro.redirect(`/usuarios/${id}?msg=guardado`);
      const errData = (await res.json().catch(() => ({ message: "Error" }))) as { message: string };
      error = errData.message ?? "Error al guardar";
    }
  }
}

const msg = Astro.url.searchParams.get("msg");
if (msg === "guardado") mensaje = "Cambios guardados";
if (msg === "toggled") mensaje = "Estado actualizado";

const rolBadge: Record<string, string> = {
  ADMIN: "bg-amber-50 text-amber-700 border-amber-200",
  MEDICO: "bg-brand-50 text-brand-700 border-brand-200",
  RECEPCION: "bg-line-soft text-ink-2 border-line",
};
---
<Layout title={usuario ? usuario.nombre : "Usuario"}>
  <a href="/usuarios" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink mb-4 transition-colors">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    Volver a usuarios
  </a>

  {!usuario ? (
    <div class="bg-white rounded-2xl border border-line p-12 text-center">
      <p class="text-muted">Usuario no encontrado.</p>
    </div>
  ) : (
    <>
      <div class="mb-6 flex items-end justify-between flex-wrap gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs text-muted font-mono">@{usuario.username}</span>
            <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium border ${rolBadge[usuario.rol]}`} style={usuario.rol === "MEDICO" ? "background:#e8ebf3;color:var(--color-navy);border-color:#b0bdd4" : undefined}>
              {usuario.rol}
            </span>
            {usuario.activo ? (
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-success">
                <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                Activo
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted">
                <span class="w-1.5 h-1.5 rounded-full bg-muted/40"></span>
                Inactivo
              </span>
            )}
          </div>
          <h1 class="font-display text-3xl font-bold text-ink">{usuario.nombre}</h1>
          <p class="text-muted mt-1 text-sm">{usuario.email || "Sin email"}</p>
        </div>
      </div>

      {mensaje && (
        <div class="mb-4 p-3.5 rounded-xl bg-success-soft border border-success/20 text-success text-sm flex items-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          {mensaje}
        </div>
      )}
      {error && (
        <div class="mb-4 p-3.5 rounded-xl bg-danger-soft border border-danger/20 text-danger text-sm">
          {error}
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
          <h2 class="font-semibold text-ink mb-4">Datos del usuario</h2>
          <form method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="nombre">Nombre completo <span class="text-danger">*</span></label>
                <input id="nombre" name="nombre" required value={usuario.nombre} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-ink mb-1.5" for="rol">Rol <span class="text-danger">*</span></label>
                <select id="rol" name="rol" required disabled={usuario.username === "admin"} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all bg-white disabled:bg-line-soft disabled:cursor-not-allowed">
                  <option value="RECEPCION" selected={usuario.rol === "RECEPCION"}>Recepción</option>
                  <option value="MEDICO" selected={usuario.rol === "MEDICO"}>Médico</option>
                  <option value="ADMIN" selected={usuario.rol === "ADMIN"}>Administrador</option>
                </select>
                {usuario.username === "admin" && <div class="text-xs text-muted mt-1">El rol del admin principal no se puede cambiar.</div>}
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink mb-1.5" for="email">Email</label>
              <input id="email" name="email" type="email" value={usuario.email ?? ""} class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink mb-1.5" for="password">Nueva contraseña <span class="text-muted font-normal">(vacío para no cambiar)</span></label>
              <input id="password" name="password" type="password" minlength="6" class="w-full px-4 py-2.5 rounded-xl border border-line focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all" placeholder="Mínimo 6 caracteres" />
            </div>
            <div class="flex items-center gap-3 pt-2">
              <button type="submit" class="btn btn-primary">Guardar cambios</button>
              <a href="/usuarios" class="btn btn-ghost">Cancelar</a>
            </div>
          </form>
        </div>

        <div class="space-y-4">
          {usuario.username !== "admin" && (
            <div class="bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
              <h3 class="font-semibold text-ink mb-2">Estado de la cuenta</h3>
              <p class="text-xs text-muted mb-3">
                {usuario.activo ? "Este usuario puede iniciar sesión." : "Este usuario no puede iniciar sesión hasta que lo actives."}
              </p>
              <form method="POST">
                <input type="hidden" name="accion" value="toggle" />
                <button type="submit" class={`w-full ${usuario.activo ? "btn btn-danger" : "btn btn-primary"}`}>
                  {usuario.activo ? "Desactivar acceso" : "Activar acceso"}
                </button>
              </form>
            </div>
          )}

          {usuario.username !== "admin" ? (
            <div class="bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
              <h3 class="font-semibold text-ink mb-2">Eliminar</h3>
              <p class="text-xs text-muted mb-3">Desactiva este usuario. No se borrará el historial de citas o consultas.</p>
              <form method="POST" onsubmit="return confirm('¿Eliminar este usuario?')">
                <input type="hidden" name="accion" value="eliminar" />
                <button type="submit" class="w-full btn btn-danger">
                  Eliminar usuario
                </button>
              </form>
            </div>
          ) : (
            <div class="bg-white rounded-2xl border border-line shadow-sm shadow-brand-900/[0.02] p-6">
              <h3 class="font-semibold text-ink mb-2">Cuenta protegida</h3>
              <p class="text-xs text-muted">Esta es la cuenta admin principal. No se puede desactivar ni eliminar para garantizar el acceso al sistema.</p>
            </div>
          )}
        </div>
      </div>
    </>
  )}
</Layout>